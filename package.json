{
  "name": "@relay-sdk/sdk-browser",
  "version": "1.3.0",
  "description": "Official Relay Delivery Platform Browser SDK - Real-time WebSocket client for frontend applications",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && rollup -c",
    "clean": "rm -rf dist",
    "dev": "rollup -c --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "relay",
    "delivery",
    "websocket",
    "realtime",
    "sdk",
    "browser"
  ],
  "author": "SendRelay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SendRelay/relay-sdk-browser.git"
  },
  "homepage": "https://sendrelay.com.ng",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "jsdom": "^29.1.1",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
